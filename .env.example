DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=media_engine
POSTGRES_USER=media_engine
POSTGRES_PASSWORD=media_engine
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Distributed node identity. Each VPS should use unique values.
MEDIA_ENGINE_VERSION=1.4.0
MEDIA_ENGINE_NODE_ID=visocarte-prod-01
MEDIA_ENGINE_PROJECT_SLUG=visocarte
MEDIA_ENGINE_TENANT_SLUG=default
MEDIA_ENGINE_DEPLOYMENT_ID=prod-eu-01

# API access between the local project and its local Media Engine node.
MEDIA_ENGINE_REQUIRE_API_KEY=1
MEDIA_ENGINE_API_KEYS=change-this-to-a-long-random-token

# Persistent last-known-good configuration.
MEDIA_ENGINE_CONFIG_DIR=/var/lib/media-engine/config

# Optional Ziarama Hub / control plane. Runtime NEVER depends on it.
MEDIA_ENGINE_CONTROL_PLANE_ENABLED=0
MEDIA_ENGINE_CONTROL_PLANE_URL=https://media-hub.example.com
MEDIA_ENGINE_CONTROL_PLANE_TOKEN=
MEDIA_ENGINE_CONTROL_PLANE_TIMEOUT_SECONDS=3
MEDIA_ENGINE_CONTROL_PLANE_CIRCUIT_SECONDS=300
MEDIA_ENGINE_CONTROL_PLANE_SYNC_SECONDS=300
MEDIA_ENGINE_WORKER_HEARTBEAT_MAX_AGE=120

MEDIA_ENGINE_PIPELINE_VERSION=1
MEDIA_ENGINE_TASK_MODE=auto
MEDIA_ENGINE_MAX_UPLOAD_BYTES=26214400
MEDIA_ENGINE_MAX_PIXELS=50000000
MEDIA_ENGINE_DEDUPLICATE=1
MEDIA_ENGINE_PUBLIC_ORIGINAL_FALLBACK=0
MEDIA_ENGINE_CDN_BASE_URL=
MEDIA_ENGINE_AUTO_FOCAL=0

USE_S3=0
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_STORAGE_BUCKET_NAME=media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# MOE 1.4 panorama 360
MEDIA_ENGINE_PANORAMA_TILE_SIZE=512
MEDIA_ENGINE_PANORAMA_MIN_LEVEL_WIDTH=1024
MEDIA_ENGINE_PANORAMA_FORMATS=avif,webp
MEDIA_ENGINE_PANORAMA_GENERATE_CUBEMAP=0
MEDIA_ENGINE_PANORAMA_CUBEMAP_FACE_SIZE=2048
MEDIA_ENGINE_PANORAMA_CUBE_MIN_SIZE=512
MEDIA_ENGINE_PANORAMA_CUBE_MAX_SIZE=4096
MEDIA_ENGINE_PANORAMA_CUBE_FORMAT=webp
MEDIA_ENGINE_PANORAMA_CUBE_QUALITY=72
